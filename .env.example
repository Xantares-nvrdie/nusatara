# Postgres (pooler / app runtime)
DATABASE_URL=postgresql://user:password@localhost:5432/nusatara
# Direct connection for drizzle-kit (push / migrate / studio)
DIRECT_URL=postgresql://user:password@localhost:5432/nusatara
# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# AI for POST /api/modules/convert. Tried in order: 1. the AI gateway, 2. Google AI Studio (backup).
# 1. Main: SumoPod AI (paid from the AI Balance in USD), or any OpenAI-compatible API.
#    Key: sumopod.com/dashboard/ai > API Keys (starts with sk-). Empty key = Google only.
AI_GATEWAY_API_KEY=sk-your-sumopod-key
# Optional, defaults to https://ai.sumopod.com/v1
# AI_GATEWAY_BASE_URL=https://ai.sumopod.com/v1
# Optional, comma separated, tried in order. Exact ids: SumoPod AI page > Models tab.
AI_GATEWAY_MODELS=gemini/gemini-3.5-flash-lite
# 2. Backup: Gemini API (https://aistudio.google.com/apikey), free tier. Also the only provider for scanned PDFs.
GEMINI_API_KEY=your-gemini-api-key
# Optional, defaults to gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
# Optional: tried in order when the Google model is busy (503) or too slow. Comma separated; empty = no fallback.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
