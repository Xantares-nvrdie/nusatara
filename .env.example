# Postgres (pooler / app runtime)
DATABASE_URL=postgresql://user:password@localhost:5432/nusatara
# Direct connection for drizzle-kit (push / migrate / studio)
DIRECT_URL=postgresql://user:password@localhost:5432/nusatara
# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Gemini API (https://aistudio.google.com/apikey), used by POST /api/modules/convert
GEMINI_API_KEY=your-gemini-api-key
# Optional, defaults to gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
# Optional: tried in order when the main model is busy (503) or too slow. Comma separated; empty = no fallback.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
